# ==============================================================================
# PGx Decision Support Backend - Environment Variables
# ==============================================================================

# Server configuration
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app

# Google Gemini API Key (for Clinical Explanations)
# Optional in demo mode: if empty, backend returns high-fidelity fallback clinical explanations
GEMINI_API_KEY=

# Pinecone Vector Store (for CPIC Guideline RAG retrieval)
# Optional in demo mode: if empty, backend uses built-in guideline corpus retriever
PINECONE_API_KEY=
PINECONE_INDEX_NAME=pgx-guidelines
PINECONE_ENVIRONMENT=us-east-1

# Optional Firebase Admin SDK (if validating Firebase Auth tokens backend-side)
FIREBASE_PROJECT_ID=
